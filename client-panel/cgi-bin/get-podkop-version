#!/bin/sh
echo "Content-Type: application/json"
echo ""

CURRENT=$(cat /usr/lib/podkop/constants.sh 2>/dev/null | grep PODKOP_VERSION | cut -d'"' -f2)
[ -z "$CURRENT" ] && CURRENT="неизвестно"

LATEST=$(curl -s --max-time 5 "https://api.github.com/repos/Jedakaya/podkop-forge/releases/latest" 2>/dev/null | jq -r '.tag_name' 2>/dev/null | tr -d 'v')
[ -z "$LATEST" ] && LATEST="недоступно"

if [ "$LATEST" = "недоступно" ]; then
    UP_TO_DATE="unknown"
elif [ "$CURRENT" = "$LATEST" ]; then
    UP_TO_DATE="true"
else
    UP_TO_DATE="false"
fi

echo "{\"current\":\"$CURRENT\",\"latest\":\"$LATEST\",\"up_to_date\":\"$UP_TO_DATE\"}"
