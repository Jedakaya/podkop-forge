#!/bin/sh
echo "Content-Type: application/json"
echo ""
read -r POST_DATA
TOKEN=$(echo "$POST_DATA" | sed 's/.*token=\([^&]*\).*/\1/')
SAVED=$(head -n 1 /tmp/vpn-auth-token 2>/dev/null)
EXPIRES=$(sed -n '2p' /tmp/vpn-auth-token 2>/dev/null)
if [ -n "$EXPIRES" ] && [ "$(date +%s)" -gt "$EXPIRES" ]; then
    rm -f /tmp/vpn-auth-token
    SAVED=""
fi
if [ "$TOKEN" != "$SAVED" ] || [ -z "$SAVED" ]; then
    echo '{"success":false,"error":"Не авторизован"}'
    exit 0
fi
echo '{"success":true}'
(sleep 2 && reboot) &
