#!/bin/sh
echo "Content-Type: application/json"
echo ""

read -r POST_DATA

TOKEN=$(echo "$POST_DATA" | sed 's/.*token=\([^&]*\).*/\1/')
SAVED=$(head -n 1 /tmp/vpn-auth-token 2>/dev/null)
EXPIRES=$(sed -n '2p' /tmp/vpn-auth-token 2>/dev/null)
if [ -n "$EXPIRES" ] && [ "$(date +%s)" -gt "$EXPIRES" ]; then
    rm -f /tmp/vpn-auth-token
    SAVED=""
fi
if [ "$TOKEN" != "$SAVED" ] || [ -z "$SAVED" ]; then
    echo '{"success":false,"error":"Не авторизован"}'
    exit 0
fi

LOCAL_IP=$(ip addr show br-lan | grep "inet " | awk '{print $2}' | cut -d'/' -f1)
[ -z "$LOCAL_IP" ] && LOCAL_IP="192.168.1.1"

urldecode() { printf '%b' "$(echo "$1" | sed 's/%/\\x/g; s/+/ /g')"; }
RAW=$(echo "$POST_DATA" | sed 's/.*server=\([^&]*\)/\1/')
SERVER=$(urldecode "$RAW")

if [ -z "$SERVER" ]; then
    echo '{"success":false,"error":"Пустое имя сервера"}'
    exit 0
fi

SERVER_JSON=$(echo "$SERVER" | jq -Rs '.[:-1]' 2>/dev/null)

RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" -X PUT "http://$LOCAL_IP:9090/proxies/main-out" \
    -H "Content-Type: application/json" \
    --data-binary "{\"name\":$SERVER_JSON}" 2>/dev/null)

NOW=$(curl -s "http://$LOCAL_IP:9090/proxies/main-out" 2>/dev/null | jq -r '.now' 2>/dev/null)

if [ "$NOW" = "$SERVER" ]; then
    echo '{"success":true}'
else
    echo "{\"success\":false,\"error\":\"Не удалось переключить\",\"requested\":$SERVER_JSON,\"now\":\"$NOW\"}"
fi
