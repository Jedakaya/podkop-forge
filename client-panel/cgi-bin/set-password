#!/bin/sh
echo "Content-Type: application/json"
echo ""

read -r POST_DATA

TOKEN=$(echo "$POST_DATA" | sed 's/.*token=\([^&]*\).*/\1/')
SAVED=$(head -n 1 /tmp/vpn-auth-token 2>/dev/null)
EXPIRES=$(sed -n '2p' /tmp/vpn-auth-token 2>/dev/null)
if [ -n "$EXPIRES" ] && [ "$(date +%s)" -gt "$EXPIRES" ]; then
    rm -f /tmp/vpn-auth-token
    SAVED=""
fi
if [ "$TOKEN" != "$SAVED" ] || [ -z "$SAVED" ]; then
    echo '{"success":false,"error":"Не авторизован"}'
    exit 0
fi

# Декодируем пароли
urldecode() { printf '%b' "$(echo "$1" | sed 's/%/\\x/g; s/+/ /g')"; }

NEW_RAW=$(echo "$POST_DATA" | sed 's/.*new_pass=\([^&]*\).*/\1/')
NEW_PASS=$(urldecode "$NEW_RAW")

CONFIRM_RAW=$(echo "$POST_DATA" | sed 's/.*confirm_pass=\([^&]*\).*/\1/')
CONFIRM_PASS=$(urldecode "$CONFIRM_RAW")

if [ -z "$NEW_PASS" ]; then
    echo '{"success":false,"error":"Введите новый пароль"}'
    exit 0
fi

if [ ${#NEW_PASS} -lt 6 ]; then
    echo '{"success":false,"error":"Пароль должен быть минимум 6 символов"}'
    exit 0
fi

if [ "$NEW_PASS" != "$CONFIRM_PASS" ]; then
    echo '{"success":false,"error":"Пароли не совпадают"}'
    exit 0
fi

# Меняем пароль
RESULT=$(printf '%s\n%s\n' "$NEW_PASS" "$NEW_PASS" | passwd root 2>&1)

# Сбрасываем токен — нужно перелогиниться с новым паролем
rm -f /tmp/vpn-auth-token

echo '{"success":true}'
